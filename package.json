{
  "name": "devign-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:server": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:build-worker": "tsx watch src/workers/buildWorker.ts",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:worker\" \"npm run dev:build-worker\"",
    "build": "tsc || true",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "start:build-worker": "node dist/workers/buildWorker.js",
    "start:all": "concurrently \"npm start\" \"npm run start:worker\" \"npm run start:build-worker\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
